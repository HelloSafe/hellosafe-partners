# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext / cloudflare workers build output + wrangler local state
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the secret-free template SHOULD be committed.
!.env.example
# wrangler/workerd local secrets for `opennextjs-cloudflare preview`.
# NOT matched by .env* above (different prefix) — must be listed explicitly.
.dev.vars
.dev.vars.*

# vercel
.vercel

# local editor config
.claude/

# drizzle-kit generated migrations (we use db:push, not migrations)
/drizzle/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
