# ─────────────────────────────────────────────────────────────────────────────
# HelloSafe Partners — environment template
#
# Copy to .env.local for local dev:   cp .env.example .env.local
# .env.local is gitignored — NEVER commit real secrets.
# In production, set these on the host (e.g. Vercel project env vars).
# ─────────────────────────────────────────────────────────────────────────────

# == Core (required) =========================================================

# Postgres connection string (Neon). Pooled connections need SSL.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret used to sign sessions / tokens. Generate: `openssl rand -base64 32`.
# BETTER_AUTH_SECRET is preferred; SESSION_SECRET is accepted as a fallback.
BETTER_AUTH_SECRET="change-me-generate-a-long-random-string"

# Canonical, public base URL of the app (no trailing slash).
# Local: http://localhost:3000 — Prod: https://partners.hellosafe.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# == Affiliate tracking ======================================================

# Shared secret the advertiser signs server-to-server postbacks with.
POSTBACK_SECRET="change-me"

# Salt for hashing visitor IPs in the clicks table (privacy).
IP_HASH_SALT="change-me"

# == Google OAuth ============================================================
# Needed for "Sign up / Sign in with Google". When BOTH are absent the Google
# button is effectively disabled (email/password still works).
# Authorized redirect URI to register in Google Cloud Console:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# == Email (Resend) ==========================================================
# Required for transactional emails (welcome, password reset, approval...).
# Without RESEND_API_KEY, sends are skipped with a console warning (no crash).
RESEND_API_KEY=""
# From address. The domain MUST be verified in Resend.
MAIL_FROM="HelloSafe Partners <noreply@partners.hellosafe.com>"
# Support address surfaced in admin emails.
SUPPORT_EMAIL="support@hellosafe.com"

# == Background jobs (Inngest) ===============================================
# Required in production to deliver queued events and verify the webhook at
# /api/inngest. In local dev the Inngest Dev Server picks events up without keys.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# == Rate limiting (Upstash Redis) ===========================================
# Optional. When unset, rate limiting falls back to in-memory (fine for a single
# instance / dev; use Upstash for serverless/multi-instance prod).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# == Product analytics (PostHog) =============================================
# Optional. Client key is public by design (NEXT_PUBLIC_*).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Server-side capture (optional).
POSTHOG_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# == Error monitoring (Sentry) ===============================================
# Optional. DSN is public; the auth token is for source-map upload at build.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# == Seeding (local / bootstrap only) ========================================
# Passwords for the demo accounts created by `npm run db:seed`. Outside prod,
# weak dev fallbacks are used if unset. In production the seed refuses to run
# unless SEED_ALLOW_PRODUCTION=true AND strong (>=8 char) passwords are given.
SEED_ADMIN_PASSWORD=""
SEED_ANTOINE_PASSWORD=""
SEED_BLOG_PASSWORD=""
SEED_AGENCY_PASSWORD=""
SEED_ALLOW_PRODUCTION="false"
